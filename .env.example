# ---- Telegram bot ----
# Get this from @BotFather (see README, "Create your bot"). Keep it secret.
BOT_TOKEN=

# Public HTTPS URL where the built frontend is served (Mini App URL).
# Telegram only accepts https:// URLs for Web App buttons.
WEB_APP_URL=

# ---- Backend ----
# Public URL of the backend API (used by the frontend build as VITE_BACKEND_URL
# when frontend and backend are on different origins). Leave empty if the backend
# serves the frontend itself (same origin).
BACKEND_URL=

# Port the backend listens on.
PORT=3000

# Comma-separated hostnames Flezen links may use. Everything else is rejected.
ALLOWED_HOSTS=flezen.com,www.flezen.com

# Flezen Bot API Key (Get this from https://flezen.com/user/bots to enable in-app video playback and download)
FLEZEN_API_KEY=

# Alternatively, paste your logged-in 'fz' cookie from Chrome/browser (DevTools > Application > Cookies)
FLEZEN_FZ=
FLEZEN_RT=

# Set to "true" to require valid Telegram initData on /api/resolve.
# Keep "false" for local browser development.
REQUIRE_TELEGRAM_AUTH=false

# Serve the built frontend (frontend/dist) from the backend. "true" is the
# simplest deployment: one HTTPS service for both the Mini App and the API.
SERVE_FRONTEND=true
